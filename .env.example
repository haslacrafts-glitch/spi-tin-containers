# Telegram Bot API — quotes are sent automatically (visitor does not open Telegram).
# One-time setup:
# 1. In Telegram, open @BotFather → /newbot → copy the token
# 2. Paste it below
# 3. From phone 7010651052, open the bot and tap Start
# 4. Run: npm run telegram:setup
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Public site URL (https) so Telegram can show a tappable “View product” button
NEXT_PUBLIC_SITE_URL=

# Live catalog + enquiry inserts (anon key only — dashboard secrets live in dashboard/.env.local)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
